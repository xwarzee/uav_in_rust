<?xml version="1.0"?>
<!--
  UAV Swarm world — ROS2 mode (mode = "ros2").
  Differences from uav_swarm_inline.sdf:
    - RestBridgePlugin removed; replaced by ros2_bridge Python node.
    - PosePublisher plugin added to each model (model-level only in Fortress):
        publishes /model/{name}/pose (geometry_msgs/Pose via ros_gz_bridge).
    - gravity disabled on each link: position is controlled by set_pose service
        at 10 Hz; without this, drones drift ~0.05 m between ticks.
  Drone visuals: same X-config quadcopter as uav_swarm_inline.sdf.
-->
<sdf version="1.8">
  <world name="uav_swarm_world">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <!-- UserCommands provides the /world/uav_swarm_world/set_pose service -->
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-apply-link-wrench-system"
            name="ignition::gazebo::systems::ApplyLinkWrench"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         DRONE 1 — red body
         ═══════════════════════════════════════════════════════════════ -->
    <model name="drone_1">
      <pose>0 0 10 0 0 0</pose>
      <enable_wind>false</enable_wind>
      <!-- PosePublisher: publishes /model/drone_1/pose at 10 Hz.
           Must be at model level (not world level) in Ignition Fortress. -->
      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="ignition::gazebo::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <update_frequency>10.0</update_frequency>
      </plugin>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.029</ixx><iyy>0.029</iyy><izz>0.052</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.62 0.62 0.10</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.18 0.18 0.05</size></box></geometry>
          <material><ambient>0.85 0.10 0.10 1</ambient><diffuse>0.85 0.10 0.10 1</diffuse></material>
        </visual>
        <visual name="arm_fr"><pose>0.0885 -0.0885 0  0 0 -0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_fl"><pose>0.0885 0.0885 0  0 0 0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_rr"><pose>-0.0885 -0.0885 0  0 0 0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_rl"><pose>-0.0885 0.0885 0  0 0 -0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="motor_fr"><pose>0.177 -0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_fl"><pose>0.177 0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_rr"><pose>-0.177 -0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_rl"><pose>-0.177 0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="prop_fr"><pose>0.177 -0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.95 0.40 0.00 0.75</ambient><diffuse>0.95 0.40 0.00 0.75</diffuse></material>
        </visual>
        <visual name="prop_rl"><pose>-0.177 0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.95 0.40 0.00 0.75</ambient><diffuse>0.95 0.40 0.00 0.75</diffuse></material>
        </visual>
        <visual name="prop_fl"><pose>0.177 0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.20 0.50 0.80 0.75</ambient><diffuse>0.20 0.50 0.80 0.75</diffuse></material>
        </visual>
        <visual name="prop_rr"><pose>-0.177 -0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.20 0.50 0.80 0.75</ambient><diffuse>0.20 0.50 0.80 0.75</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         DRONE 2 — green body
         ═══════════════════════════════════════════════════════════════ -->
    <model name="drone_2">
      <pose>5 0 10 0 0 0</pose>
      <enable_wind>false</enable_wind>
      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="ignition::gazebo::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <update_frequency>10.0</update_frequency>
      </plugin>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.029</ixx><iyy>0.029</iyy><izz>0.052</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.62 0.62 0.10</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.18 0.18 0.05</size></box></geometry>
          <material><ambient>0.10 0.78 0.20 1</ambient><diffuse>0.10 0.78 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_fr"><pose>0.0885 -0.0885 0  0 0 -0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_fl"><pose>0.0885 0.0885 0  0 0 0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_rr"><pose>-0.0885 -0.0885 0  0 0 0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_rl"><pose>-0.0885 0.0885 0  0 0 -0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="motor_fr"><pose>0.177 -0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_fl"><pose>0.177 0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_rr"><pose>-0.177 -0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_rl"><pose>-0.177 0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="prop_fr"><pose>0.177 -0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.95 0.40 0.00 0.75</ambient><diffuse>0.95 0.40 0.00 0.75</diffuse></material>
        </visual>
        <visual name="prop_rl"><pose>-0.177 0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.95 0.40 0.00 0.75</ambient><diffuse>0.95 0.40 0.00 0.75</diffuse></material>
        </visual>
        <visual name="prop_fl"><pose>0.177 0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.20 0.50 0.80 0.75</ambient><diffuse>0.20 0.50 0.80 0.75</diffuse></material>
        </visual>
        <visual name="prop_rr"><pose>-0.177 -0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.20 0.50 0.80 0.75</ambient><diffuse>0.20 0.50 0.80 0.75</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         DRONE 3 — blue body
         ═══════════════════════════════════════════════════════════════ -->
    <model name="drone_3">
      <pose>-5 0 10 0 0 0</pose>
      <enable_wind>false</enable_wind>
      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="ignition::gazebo::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <update_frequency>10.0</update_frequency>
      </plugin>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.029</ixx><iyy>0.029</iyy><izz>0.052</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.62 0.62 0.10</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.18 0.18 0.05</size></box></geometry>
          <material><ambient>0.10 0.30 0.90 1</ambient><diffuse>0.10 0.30 0.90 1</diffuse></material>
        </visual>
        <visual name="arm_fr"><pose>0.0885 -0.0885 0  0 0 -0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_fl"><pose>0.0885 0.0885 0  0 0 0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_rr"><pose>-0.0885 -0.0885 0  0 0 0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_rl"><pose>-0.0885 0.0885 0  0 0 -0.7854</pose>
          <geometry><box><size>0.25 0.016 0.016</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="motor_fr"><pose>0.177 -0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_fl"><pose>0.177 0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_rr"><pose>-0.177 -0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="motor_rl"><pose>-0.177 0.177 0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="prop_fr"><pose>0.177 -0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.95 0.40 0.00 0.75</ambient><diffuse>0.95 0.40 0.00 0.75</diffuse></material>
        </visual>
        <visual name="prop_rl"><pose>-0.177 0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.95 0.40 0.00 0.75</ambient><diffuse>0.95 0.40 0.00 0.75</diffuse></material>
        </visual>
        <visual name="prop_fl"><pose>0.177 0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.20 0.50 0.80 0.75</ambient><diffuse>0.20 0.50 0.80 0.75</diffuse></material>
        </visual>
        <visual name="prop_rr"><pose>-0.177 -0.177 0.052 0 0 0</pose>
          <geometry><cylinder><radius>0.115</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.20 0.50 0.80 0.75</ambient><diffuse>0.20 0.50 0.80 0.75</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
