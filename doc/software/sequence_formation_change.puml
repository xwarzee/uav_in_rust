@startuml Formation Change Sequence
!theme plain
autonumber

actor User
participant "HTTP Handler\nPOST /api/formations/current\n(src/api/handlers/formations.rs)" as Handler
participant "AppState\n(Arc<Mutex<DroneSwarm>>)" as State
participant "DroneSwarm" as Swarm
participant "FormationManager" as FormMgr
participant "EventPublisher\n(BroadcastEventPublisher)" as EP
participant "WebSocket Clients" as WS

User -> Handler: POST /api/formations/current\n{ "formation_type": "triangle" }
activate Handler

Handler -> Handler: FormationType::from_str("triangle")\n→ Ok(Triangle) or Err(ApiError)

Handler -> State: swarm.lock().await
activate State
State --> Handler: MutexGuard<DroneSwarm>

Handler -> Swarm: set_formation("triangle")
activate Swarm

Swarm -> FormMgr: set_formation_type(Triangle)
activate FormMgr

FormMgr -> FormMgr: update formation_type
FormMgr -> FormMgr: calculate_offsets()

alt Triangle Formation
  FormMgr -> FormMgr: Leader: (0, 0, 0)\nLeft: (-d, -d*0.866, 0)\nRight: (d, -d*0.866, 0)
else Line Formation
  FormMgr -> FormMgr: Spread drones along X axis\n((i-1)*d, 0, 0)
else V Formation
  FormMgr -> FormMgr: Leader: (0, 0, 0)\nLeft: (-d, -d, 0)\nRight: (d, -d, 0)
end

FormMgr -> FormMgr: update_formation(drones)
FormMgr -> FormMgr: move_to() or set_formation_offset()\nfor each drone

deactivate FormMgr
deactivate Swarm

Handler -> FormMgr: is_formation_stable(drones) → bool
note right: checked while lock is held

Handler -> State: drop MutexGuard (lock released)
deactivate State

Handler -> EP: publish(FormationUpdate { formation_stable })
activate EP
EP -> WS: broadcast DroneUpdate::FormationUpdate
EP --> Handler:
deactivate EP

Handler --> User: 200 OK\n{ "message": "Formation changed to triangle" }
deactivate Handler

note over EP, WS
  All subscribed WebSocket clients
  (state.event_publisher.subscribe())
  receive the FormationUpdate
  immediately after the change.
end note

@enduml
