@startuml Mission Execution Sequence
!theme plain
autonumber

actor User
participant "HTTP Handler\nPOST /api/missions\n(src/api/handlers/missions.rs)" as Handler
participant "AppState\n(Arc<Mutex<DroneSwarm>>)" as State
participant "DroneSwarm" as Swarm
participant "MissionExecutor" as ME
participant "Mission" as Mission
participant "EventPublisher\n(BroadcastEventPublisher)" as EP
participant "WebSocket Clients" as WS

User -> Handler: POST /api/missions\n{ "MoveTo": { "target": {...} } }
activate Handler

Handler -> State: swarm.lock().await
activate State
State --> Handler: MutexGuard<DroneSwarm>

Handler -> Handler: collect drone_ids

Handler -> ME: create_mission(MissionType::MoveTo(target), drone_ids)
activate ME
ME -> Mission: new(mission_id, mission_type)
activate Mission
Mission -> Mission: initialize waypoints from mission_type
Mission --> ME: Mission
deactivate Mission
ME -> ME: store in active_missions
ME --> Handler: mission_id
deactivate ME

Handler -> ME: start_mission(mission_id)
activate ME
ME -> Mission: start() → status = InProgress, current_waypoint = 0
ME --> Handler: Ok()
deactivate ME

Handler -> State: drop MutexGuard (lock released)
deactivate State

Handler -> Handler: tokio::spawn(tick loop)
note right: handler responds immediately\nwhile the mission runs\nin the background

Handler --> User: 200 OK\n{ "id": "...", "status": "in_progress" }
deactivate Handler

group Tick loop (tokio::spawn — every 100ms)
  loop mission running
    Handler -> State: swarm.lock().await
    activate State
    State --> Handler: MutexGuard<DroneSwarm>

    Handler -> Swarm: tick_mission_by_id(mission_id)
    activate Swarm
    Swarm -> ME: tick
    ME -> Mission: get_current_target()
    Mission --> ME: waypoint_position
    ME -> ME: move drones toward waypoint
    ME -> Mission: advance_waypoint() on arrival

    alt Mission still running
      ME --> Swarm: Ok(true)
    else Mission completed
      ME --> Swarm: Ok(false)
    end
    Swarm --> Handler: Result<bool, String>
    deactivate Swarm

    Handler -> ME: active_missions.get(id).current_waypoint
    ME --> Handler: waypoint: usize

    Handler -> State: drop MutexGuard
    deactivate State

    Handler -> EP: publish(MissionProgress { mission_id, waypoint })
    activate EP
    EP -> WS: broadcast DroneUpdate::MissionProgress
    EP --> Handler:
    deactivate EP

    alt Ok(true) — mission continues
      Handler -> Handler: sleep(100ms)
    else Ok(false) — mission completed
      Handler -> Handler: break
    else Err(e) — mission failed
      Handler -> Handler: log error, break
    end
  end
end

note over EP, WS
  WebSocket clients receive a
  MissionProgress event on each tick (100ms)
  with the current waypoint index.
end note

@enduml
