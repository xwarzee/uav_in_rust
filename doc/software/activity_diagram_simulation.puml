@startuml Simulation Activity Diagram
!theme plain

start

:Parse CLI arguments (clap);

if (Command?) then (serve)

  :Initialize DroneSwarm\n(add N drones with initial positions);

  :Create BroadcastEventPublisher;

  :Create AppState\n(swarm + event_publisher + config);

  :Start actix-web HTTP server\n(host:port);

  fork
    group REST API — HTTP handlers
      repeat
        if (Request?) then (GET /api/swarm)
          :Return swarm status;

        elseif (Request?) then (POST /api/swarm/start)
          :Set simulation_running = true;
          :tokio::spawn(simulation loop);

          fork
            group Simulation loop (100ms ticks)
              repeat
                :swarm.lock();
                :update_swarm() — update_position(dt)\nfor each drone;
                :get_swarm_status() → Vec<DroneStatusInfo>;
                :drop lock;
                :event_publisher.publish(\n  PositionUpdate for each drone\n);
                :sleep 100ms;
              repeat while (simulation_running?)
            end group
          end fork

        elseif (Request?) then (POST /api/formations/current)
          :Validate formation_type;
          :swarm.lock();
          :set_formation(type)\n→ FormationManager.update();
          :is_formation_stable() → bool;
          :drop lock;
          :event_publisher.publish(\n  FormationUpdate { formation_stable }\n);
          :200 OK;

        elseif (Request?) then (POST /api/missions)
          :swarm.lock();
          :create_mission(type, drone_ids);
          :start_mission(id);
          :drop lock;
          :tokio::spawn(tick loop);

          fork
            group Mission tick loop (100ms ticks)
              repeat
                :swarm.lock();
                :tick_mission_by_id(id) → bool;
                :get current_waypoint;
                :drop lock;
                :event_publisher.publish(\n  MissionProgress { id, waypoint }\n);
                :sleep 100ms;
              repeat while (mission running?)
            end group
          end fork

          :200 OK { id, status: "in_progress" };

        elseif (Request?) then (PUT /api/drones/{id}/state)
          note right: Gazebo bridge push
          :swarm.lock();
          :drone.position = state_update.position;
          :drone.velocity = state_update.velocity;
          :drop lock;
          :event_publisher.publish(\n  PositionUpdate { drone_id, position, velocity }\n);
          :200 OK;

        else (other REST endpoints)
          :Handle drones GET/PUT,\nmissions GET/DELETE, etc.;
        endif
      repeat while (server running?)
    end group

  fork again
    group WebSocket — ws://host/ws
      repeat
        :websocket_handler accepts connection;
        :rx = event_publisher.subscribe();
        fork
          repeat
            :rx.recv() → DroneUpdate;
            :session.text(serde_json::to_string(update));
          repeat while (connection open?)
        fork again
          repeat
            :Handle incoming WS messages\n(Ping → Pong, Close → close);
          repeat while (connection open?)
        end fork
      repeat while (server running?)
    end group

  fork again
    group Simulation Engine (optional — Gazebo mode)
      :GazeboSimulationEngine.initialize();
      :check_connection() → health check;
      :start_sync();
      repeat
        :state_source.fetch_states()\n→ GET {bridge_url}/drones/states;
        :update drone.position + velocity;
        :send_command() if target_position changed\n→ POST {bridge_url}/drones/{id}/command;
        :sleep dt;
      repeat while (connected?)
    end group

  end fork

elseif (Command?) then (simulate)
  :Initialize DroneSwarm;

  :Select InternalSimulationEngine\nor GazeboSimulationEngine;

  :engine.initialize();

  repeat
    :engine.update_drones(drones, dt);
    :swarm.update_swarm();
    :print swarm status;
    :sleep dt;
  repeat while (running?)

  :engine.shutdown();

elseif (Command?) then (status)
  :Initialize DroneSwarm;
  :Print swarm status summary;

else (help / unknown)
  :Print usage information;
endif

stop

@enduml
